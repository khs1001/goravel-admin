{
  "type": "page",
  "title": "岗位管理",
  "body": {
    "type": "crud",
    "api": "get:/admin-api/system/post/list",
    "filterTogglable": true,
    "filter": {
      "title": "查询条件",
      "body": [
        {"type": "input-text", "name": "postName", "label": "岗位名称", "size": "md", "clearable": true},
        {"type": "input-text", "name": "postCode", "label": "岗位编码", "size": "md", "clearable": true},
        {"type": "select", "name": "status", "label": "状态", "size": "md", "clearable": true, "options": [{"label": "正常", "value": "0"}, {"label": "停用", "value": "1"}]}
      ]
    },
    "headerToolbar": [
      {
        "type": "button",
        "label": "新增",
        "level": "primary",
        "actionType": "dialog",
        "dialog": {
          "title": "新增岗位",
          "size": "lg",
          "body": {
            "type": "form",
            "api": "post:/admin-api/system/post",
            "body": [
              {"type": "input-text", "name": "postName", "label": "岗位名称", "required": true},
              {"type": "input-text", "name": "postCode", "label": "岗位编码", "required": true},
              {"type": "input-number", "name": "postSort", "label": "显示顺序", "value": 1},
              {"type": "select", "name": "status", "label": "状态", "value": "0", "options": [{"label": "正常", "value": "0"}, {"label": "停用", "value": "1"}]},
              {"type": "textarea", "name": "remark", "label": "备注"}
            ]
          }
        }
      },
      {"type": "reload", "align": "right"}
    ],
    "columns": [
      {"name": "postId", "label": "ID", "width": 80},
      {"name": "postName", "label": "岗位名称"},
      {"name": "postCode", "label": "岗位编码"},
      {"name": "postSort", "label": "顺序", "width": 80},
      {"name": "status", "label": "状态", "type": "mapping", "map": {"0": "正常", "1": "停用"}},
      {
        "type": "operation",
        "label": "操作",
        "buttons": [
          {
            "type": "button",
            "label": "编辑",
            "level": "link",
            "actionType": "dialog",
            "dialog": {
              "title": "编辑岗位",
              "size": "lg",
              "body": {
                "type": "form",
                "api": "put:/admin-api/system/post",
                "initApi": "get:/admin-api/system/post/${postId}",
                "body": [
                  {"type": "hidden", "name": "postId"},
                  {"type": "input-text", "name": "postName", "label": "岗位名称", "required": true},
                  {"type": "input-text", "name": "postCode", "label": "岗位编码", "required": true},
                  {"type": "input-number", "name": "postSort", "label": "显示顺序"},
                  {"type": "select", "name": "status", "label": "状态", "options": [{"label": "正常", "value": "0"}, {"label": "停用", "value": "1"}]},
                  {"type": "textarea", "name": "remark", "label": "备注"}
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "删除",
            "level": "link",
            "className": "text-danger",
            "actionType": "ajax",
            "confirmText": "确认删除该岗位？",
            "api": "delete:/admin-api/system/post/${postId}"
          }
        ]
      }
    ]
  }
}
