{
  "type": "page",
  "title": "个人设置",
  "body": {
    "type": "form",
    "mode": "horizontal",
    "labelWidth": 120,
    "panelClassName": "px-48 m:px-0",
    "initApi": "get:/admin-api/user_setting",
    "api": "put:/admin-api/user_setting",
    "submitText": "保存",
    "body": [
      {"type": "input-image", "name": "avatar", "label": "头像", "receiver": "post:/admin-api/upload_image", "accept": ".jpg,.jpeg,.png,.gif", "width": 200, "height": 200},
      {"type": "input-text", "name": "username", "label": "用户名", "disabled": true},
      {"type": "input-text", "name": "nickName", "label": "昵称", "required": true},
      {"type": "input-text", "name": "email", "label": "邮箱"},
      {"type": "input-text", "name": "phonenumber", "label": "手机号"},
      {"type": "select", "name": "sex", "label": "性别", "options": [{"label": "男", "value": "0"}, {"label": "女", "value": "1"}, {"label": "未知", "value": "2"}]},
      {"type": "divider", "label": "修改密码（留空则不修改）"},
      {"type": "input-password", "name": "old_password", "label": "原密码"},
      {"type": "input-password", "name": "password", "label": "新密码"},
      {"type": "input-password", "name": "confirm_password", "label": "确认密码"}
    ]
  }
}
